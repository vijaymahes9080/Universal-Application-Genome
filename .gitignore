# ==========================================
# Universal Application Genome (UAG) Git Ignore
# ==========================================

# Python Backend
backend/.venv/
backend/venv/
backend/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
.npm
*.tsbuildinfo
next-env.d.ts

# Database Files
*.db
*.sqlite
*.sqlite3
uag_database.db
backend/*.db

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# IDEs & System Files
.vscode/
.idea/
.gemini/
.agents
.DS_Store
Thumbs.db
